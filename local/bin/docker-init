#!/bin/sh

set -e

LC_ALL=C

MACHINE=$(uname -m)

docker-install -r -u -c su-exec sudo vim build-essential software-properties-common apt-transport-https wget git dialog bash-completion openssh-client gcc-multilib python

mkdir -p /etc/sudoers.d
ln -sf /usr/local/etc/sudoers /etc/sudoers.d/sudoers

cp -R /etc/skel/. /root/

